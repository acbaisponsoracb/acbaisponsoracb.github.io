    <style>
        * {
            box-sizing: border-box;
            font-family: 'Vazirmatn', sans-serif !important; 
        }
        
        html {
            scroll-behavior: smooth;
        }

        body {
            -webkit-tap-highlight-color: transparent;
            background-color: #f8fafc; 
            color: #0f172a;
            transition: background-color 0.3s ease, color 0.3s ease;
            overflow-x: clip; 
        }

        .dark body {
            background-color: #09090b; 
            color: #f4f4f5;
        }

        /* Ambient Premium Glow Lighting */
        .halo-ambient-container {
            position: fixed;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
            z-index: 0;
        }

        .top-halo-ambient {
            position: absolute;
            top: -160px;
            left: 50%;
            transform: translateX(-50%);
            width: 85vw;
            max-width: 960px;
            height: 380px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(148, 163, 184, 0.25) 0%, rgba(248, 250, 252, 0) 70%);
            filter: blur(85px);
        }

        .dark .top-halo-ambient {
            background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, rgba(9, 9, 11, 0) 70%);
            filter: blur(90px);
        }

        .edge-halo-r {
            position: absolute;
            top: 25%;
            right: -120px;
            width: 400px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(203, 213, 225, 0.4) 0%, rgba(248, 250, 252, 0) 70%);
            filter: blur(90px);
        }

        .edge-halo-l {
            position: absolute;
            top: 60%;
            left: -120px;
            width: 400px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(203, 213, 225, 0.4) 0%, rgba(248, 250, 252, 0) 70%);
            filter: blur(90px);
        }

        .dark .edge-halo-r {
            background: radial-gradient(circle, rgba(99, 102, 241, 0.09) 0%, rgba(9, 9, 11, 0) 70%);
            filter: blur(100px);
        }

        .dark .edge-halo-l {
            background: radial-gradient(circle, rgba(168, 85, 247, 0.08) 0%, rgba(9, 9, 11, 0) 70%);
            filter: blur(100px);
        }

        /* Sticky Header & Glass Surfaces */
        .main-sticky-nav {
            position: -webkit-sticky;
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            transform: translateZ(0); 
        }

        .dark .main-sticky-nav {
            background: rgba(12, 12, 15, 0.85);
            border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(226, 232, 240, 0.85);
            box-shadow: 0 10px 30px -6px rgba(15, 23, 42, 0.04);
            transition: all 0.3s ease;
        }
        
        .dark .glass-panel {
            background: rgba(18, 18, 22, 0.8); 
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 10px 35px -6px rgba(0, 0, 0, 0.5);
        }

        .glass-button {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.9);
            color: #0f172a;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-button:hover {
            background: #ffffff;
            transform: translateY(-1.5px);
        }

        .dark .glass-button {
            background: rgba(39, 39, 42, 0.55); 
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #f4f4f5;
        }

        .dark .glass-button:hover {
            background: rgba(52, 52, 58, 0.85);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .glass-icon {
            background: rgba(241, 245, 249, 0.9);
            border: 1px solid rgba(226, 232, 240, 0.9);
        }
        
        .dark .glass-icon {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.09);
        }

        .btn-formal {
            background-color: #0f172a;
            color: #ffffff;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-formal:hover {
            background-color: #1e293b;
            transform: translateY(-1.5px);
        }
        .dark .btn-formal {
            background-color: #f4f4f5;
            color: #09090b;
        }
        .dark .btn-formal:hover {
            background-color: #e4e4e7;
            transform: translateY(-1.5px);
        }

        /* 3D Stacked Deck Styling - Full Bleed Image Cards (بدون کادرهای اضافه) */
        .deck-stage {
            perspective: 1200px;
            perspective-origin: 50% 50%;
            height: 415px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            overflow: visible;
            touch-action: pan-y;
        }

        .deck-card {
            position: absolute;
            width: 280px;
            height: 385px;
            border-radius: 1.75rem;
            transition: transform 0.45s cubic-bezier(0.25, 1, 0.35, 1), 
                        opacity 0.35s ease, 
                        box-shadow 0.35s ease, 
                        filter 0.35s ease;
            transform-style: preserve-3d;
            will-change: transform, opacity;
            cursor: pointer;
            user-select: none;
            -webkit-user-select: none;
        }

        @media (min-width: 640px) {
            .deck-stage {
                height: 425px;
            }
            .deck-card {
                width: 300px;
                height: 390px;
            }
        }

        .deck-card.active-sub-card {
            border-color: #0f172a !important;
            box-shadow: 0 22px 45px -10px rgba(15, 23, 42, 0.22) !important;
        }

        .dark .deck-card.active-sub-card {
            border-color: rgba(255, 255, 255, 0.75) !important;
            box-shadow: 0 24px 50px -10px rgba(0, 0, 0, 0.85), 0 0 25px rgba(255, 255, 255, 0.08) !important;
        }

        .plan-tab-btn {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .plan-tab-btn.active {
            background-color: #0f172a;
            color: #ffffff;
            box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.25);
        }
        .dark .plan-tab-btn.active {
            background-color: #f4f4f5;
            color: #09090b;
            box-shadow: 0 4px 14px -2px rgba(255, 255, 255, 0.2);
        }

        /* Full-Size Banner Slider (بدون حاشیه و کادر اضافه) */
        .banner-slide {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.6s ease-in-out, transform 0.8s ease;
            transform: scale(1.03);
            z-index: 1;
        }

        .banner-slide.active {
            opacity: 1;
            transform: scale(1);
            z-index: 2;
        }

        .dot {
            transition: all 0.25s ease;
        }
        .dot.active {
            background-color: #ffffff;
            width: 22px;
            border-radius: 9999px;
        }

        /* Scroll Reveal Animations */
        .reveal-left {
            opacity: 0;
            transform: translateX(35px);
            transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal-right {
            opacity: 0;
            transform: translateX(-35px);
            transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal-up {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 
